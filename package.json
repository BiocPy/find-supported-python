{
  "name": "find-supported-python",
  "description": "Find supported versions of Python, i.e., not EOL.",
  "version": "1.0.1",
  "author": "Aaron Lun <infinite.monkeys.with.keyboards@gmail.com>",
  "private": false,
  "type": "module",
  "homepage": "https://github.com/BiocPy/find-supported-python#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BiocPy/find-supported-python.git"
  },
  "bugs": {
    "url": "https://github.com/BiocPy/find-supported-python/issues"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Python"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.js",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "rollup": "^4.68.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
